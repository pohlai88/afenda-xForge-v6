BASEPATH=
NEXT_PUBLIC_APP_URL=

# shadcn/studio Pro. Copy to .env (git-ignored) and fill in from your
# shadcnstudio.com account. The shadcn CLI reads these to authenticate the
# @ss-* registries in components.json.
#
# The MCP server needs the same two values a second time, in the git-ignored
# .claude/settings.local.json "env" block — Claude Code does not read .env.
# See README > shadcn/studio MCP.
SHADCN_STUDIO_EMAIL=
SHADCN_STUDIO_API_KEY=
