{
  "$comment": "Project-scoped Claude Code config, checked in. Never put secrets here - personal credentials belong in settings.local.json, which .gitignore excludes.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/preflight.mjs",
            "timeout": 10,
            "statusMessage": "Preflight: design system"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/format.mjs",
            "timeout": 30,
            "statusMessage": "Formatting the edited file (prettier)"
          }
        ]
      }
    ]
  }
}
